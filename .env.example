# Copia este archivo como .env. No publiques el archivo .env real.
POSTGRES_DB=buenplato
POSTGRES_USER=buenplato
POSTGRES_PASSWORD=cambiar_por_una_clave_larga
POSTGRES_PORT=5432
WEB_PORT=80

# Orígenes autorizados para desarrollo. En EC2 se reemplaza por http://IP_PUBLICA.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost,http://127.0.0.1

# Ajustado para una máquina pequeña. Puede aumentarse si hay más memoria.
JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:+UseSerialGC
